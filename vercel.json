{
  "version": 2, 
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap-cjs.xml"
    },
    {
      "source": "/sitemap-main.xml",
      "destination": "/api/sitemap-main"
    },
    {
      "source": "/sitemap/store_([^/]+).xml",
      "destination": "/api/sitemap-store?storeId=$1"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/sitemap-main.js": {
      "maxDuration": 30
    },
    "api/sitemap.js": {
      "maxDuration": 30
    },
    "api/sitemap.xml.js": {
      "maxDuration": 30
    },
    "api/sitemap-store.js": {
      "maxDuration": 20
    }
  },
